        }
      }
    },
    "ProperWM is still running. You can try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM还在运行，可以重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM is still running. You can try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM仍在執行，可以再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWMはまだ実行中です。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM läuft noch. Du kannst es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM est toujours en cours d’exécution. Vous pouvez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM sigue en ejecución. Puedes volver a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM sigue en ejecución. Puedes intentarlo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM ainda está em execução. Você pode tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM continua em execução. Pode voltar a tentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM è ancora in esecuzione. Puoi riprovare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM가 아직 실행 중입니다. 다시 시도할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM все еще работает. Можно повторить попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM hâlâ çalışıyor. Yeniden deneyebilirsiniz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM अभी भी चल रहा है। आप फिर कोशिश कर सकते हैं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM vẫn đang chạy. Bạn có thể thử lại."
          }
        }
      }
    },
    "ProperWM just lost its Accessibility permission, so the taskbar has been put away. Turn ProperWM back on in %@.": {
      "comment": "%@ 同上",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM刚才失去了辅助功能权限，Dock 栏已经收起。请在%@中重新打开 ProperWM的开关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM just lost its Accessibility permission, so the taskbar has been put away. Turn ProperWM back on in %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM剛才失去了輔助使用權限，工作列已經收起。請在%@中重新打開ProperWM的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWMのアクセシビリティの許可が失われたため、タスクバーを格納しました。%@でProperWMをもう一度オンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM hat gerade seine Bedienungshilfen-Berechtigung verloren, deshalb wurde die Taskleiste eingeklappt. Aktiviere ProperWM unter %@ wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM vient de perdre son autorisation d’accessibilité ; la barre des tâches a donc été retirée. Réactivez ProperWM dans %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM acaba de perder el permiso de accesibilidad, por lo que se ha ocultado la barra de tareas. Vuelve a activar ProperWM en %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM acaba de perder el permiso de accesibilidad, por lo que se ocultó la barra de tareas. Vuelve a activar ProperWM en %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM acabou de perder a permissão de Acessibilidade, então a barra de tarefas foi recolhida. Ative o ProperWM novamente em %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM acabou de perder a permissão de Acessibilidade, pelo que a barra de tarefas foi recolhida. Volte a ativar o ProperWM em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM ha appena perso l’autorizzazione di accessibilità, quindi la barra delle applicazioni è stata nascosta. Riattiva ProperWM in %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM가 방금 손쉬운 사용 권한을 잃어 작업 표시줄을 숨겼습니다. %@에서 ProperWM를 다시 켜십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ProperWM только что лишилось разрешения универсального доступа, поэтому панель задач убрана. Снова включите ProperWM здесь: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM Erişilebilirlik iznini az önce kaybetti, bu yüzden görev çubuğu gizlendi. Şu konumda ProperWM’in anahtarını yeniden açın: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM की ऐक्सेसिबिलिटी अनुमति अभी-अभी हट गई, इसलिए टास्कबार हटा दिया गया है। %@ में ProperWM को फिर से चालू करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM vừa mất quyền Trợ năng nên thanh tác vụ đã được cất đi. Hãy bật lại ProperWM trong %@."
          }
        }
      }
    },
    "ProperWM needs this permission to read and manage your windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM 需要这项权限来读取和操作窗口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM needs this permission to read and manage your windows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM需要這項權限來讀取與管理你的視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWMはウインドウを読み取って操作するために、この許可を必要とします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM benötigt diese Berechtigung, um deine Fenster zu lesen und zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM a besoin de cette autorisation pour lire et gérer vos fenêtres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM necesita este permiso para leer y gestionar tus ventanas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM necesita este permiso para leer y administrar tus ventanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM precisa desta permissão para ler e gerenciar suas janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM precisa desta permissão para ler e gerir as suas janelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM richiede questa autorizzazione per leggere e gestire le finestre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM가 윈도우를 읽고 관리하려면 이 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению ProperWM нужно это разрешение, чтобы получать сведения об окнах и управлять ими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM’in pencerelerinizi okuyabilmesi ve yönetebilmesi için bu izne ihtiyacı var."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM को आपकी विंडो पढ़ने और प्रबंधित करने के लिए इस अनुमति की ज़रूरत है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM cần quyền này để đọc và quản lý các cửa sổ của bạn."
          }
        }
      }
    },
    "ProperWM will restart itself once you grant it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授权后ProperWM会自动重启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM will restart itself once you grant it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授權後ProperWM會自行重新啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度許可すると、ProperWMは自動的に再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du sie erneut erteilst, startet sich ProperWM von selbst neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM redémarrera de lui-même une fois l’autorisation réaccordée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM se reiniciará automáticamente cuando vuelvas a concederle el permiso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM se reiniciará automáticamente cuando vuelvas a otorgarle el permiso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM será reiniciado sozinho assim que você conceder a permissão novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProperWM reinicia-se sozinho assim que voltar a conceder a permissão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM si riavvierà automaticamente dopo la nuova autorizzazione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 허용하면 ProperWM가 자동으로 재실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ProperWM перезапустится само, как только разрешение будет выдано снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzni yeniden verdiğinizde ProperWM kendini yeniden çalıştıracak."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दोबारा अनुमति देते ही ProperWM अपने आप रीस्टार्ट हो जाएगा।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProperWM sẽ tự khởi chạy lại sau khi bạn cấp lại quyền."
          }
        }
      }
    },
    "Turn On Accessibility Permission": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要开启辅助功能权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Accessibility Permission"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟輔助使用權限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを許可してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Berechtigung aktivieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l’autorisation d’accessibilité"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permiso de accesibilidad"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el permiso de accesibilidad"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a permissão de Acessibilidade"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a permissão de Acessibilidade"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’autorizzazione di accessibilità"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한 켜기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить разрешение универсального доступа"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik İznini Aç"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेसिबिलिटी अनुमति चालू करें"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền Trợ năng"
          }
        }
      }
    },
    "Turn on ProperWM in %@. This window closes by itself once you do, and the taskbar finishes starting.": {
      "comment": "%@ 是系统设置里的权限路径，随 macOS 版本不同",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在%@中，打开 ProperWM的开关。开启后本窗口会自动关闭，Dock 栏会继续启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on ProperWM in %@. This window closes by itself once you do, and the taskbar finishes starting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在%@中打開ProperWM的開關。打開後這個視窗會自動關閉，工作列也會繼續啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でProperWMをオンにしてください。オンにするとこのウインドウは自動的に閉じ、タスクバーの起動が完了します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere ProperWM unter %@. Sobald du das getan hast, schließt sich dieses Fenster von selbst und die Taskleiste startet vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ProperWM dans %@. Cette fenêtre se ferme alors d’elle-même et la barre des tâches termine son démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa ProperWM en %@. Esta ventana se cerrará sola cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa ProperWM en %@. Esta ventana se cerrará automáticamente cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o ProperWM em %@. Esta janela se fecha sozinha quando você fizer isso, e a barra de tarefas termina de iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o ProperWM em %@. Esta janela fecha-se sozinha assim que o fizer e a barra de tarefas conclui o arranque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva ProperWM in %@. Questa finestra si chiude da sola quando lo fai e la barra delle applicazioni completa l’avvio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 ProperWM를 켜십시오. 켜면 이 윈도우가 자동으로 닫히고 작업 표시줄이 시작됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите ProperWM здесь: %@. Окно закроется само, и панель задач завершит запуск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu konumda ProperWM’in anahtarını açın: %@. Bunu yaptığınızda bu pencere kendiliğinden kapanır ve görev çubuğunun başlatılması tamamlanır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में ProperWM चालू करें। चालू करते ही यह विंडो अपने आप बंद हो जाएगी और टास्कबार पूरी तरह शुरू हो जाएगा।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật ProperWM trong %@. Cửa sổ này sẽ tự đóng ngay khi bạn bật, và thanh tác vụ sẽ khởi động xong."
          }
        }
      }
    },
    "macOS ties Accessibility permission to one specific copy of an app. This copy is running from a temporary or read-only location, so turning the switch on will not take effect — and the permission record stays behind in System Settings after the disk image is ejected. Drag ProperWM to your Applications folder and open it from there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会把辅助功能授权绑定到具体的应用副本上。当前这份ProperWM跑在一个临时或只读的位置，就算你打开了开关也不会生效，而且卸载磁盘映像后那条授权记录还会留在系统里。请把 ProperWM 拖到“应用程序”文件夹，再从那里重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ties Accessibility permission to one specific copy of an app. This copy is running from a temporary or read-only location, so turning the switch on will not take effect — and the permission record stays behind in System Settings after the disk image is ejected. Drag ProperWM to your Applications folder and open it from there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS會把輔助使用權限綁定到某一份特定的App副本上。目前這份執行於暫時或唯讀的位置，就算打開開關也不會生效，而且退出磁碟映像檔後，那筆權限記錄還會留在「系統設定」裡。請把ProperWM拖到「應用程式」檔案夾，再從那裡重新打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはアクセシビリティの許可を、アプリの特定のコピーに結び付けます。このコピーは一時的な場所または読み出し専用の場所で実行されているため、スイッチをオンにしても反映されません。さらに、ディスクイメージを取り出したあとも、許可の記録がシステム設定に残ります。ProperWMを「アプリケーション」フォルダにドラッグし、そこから開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bindet die Bedienungshilfen-Berechtigung an genau eine Kopie einer App. Diese Kopie läuft von einem temporären oder schreibgeschützten Ort, deshalb bleibt das Aktivieren des Schalters wirkungslos – und der Berechtigungseintrag bleibt nach dem Auswerfen des Images in den Systemeinstellungen zurück. Bewege ProperWM in den Ordner „Programme“ und öffne es von dort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS associe l’autorisation d’accessibilité à une copie précise d’une app. Cette copie s’exécute depuis un emplacement temporaire ou en lecture seule, si bien qu’activer l’interrupteur restera sans effet — et l’autorisation restera inscrite dans Réglages Système après l’éjection de l’image disque. Faites glisser ProperWM dans votre dossier Applications, puis ouvrez-le depuis là."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asocia el permiso de accesibilidad a una copia concreta de cada app. Esta copia se está ejecutando desde una ubicación temporal o de solo lectura, así que activar el interruptor no surtirá efecto, y el registro del permiso se queda en Ajustes del Sistema después de expulsar la imagen de disco. Arrastra ProperWM a la carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asocia el permiso de accesibilidad a una copia específica de cada app. Esta copia se está ejecutando desde una ubicación temporal o de sólo lectura, así que activar el interruptor no tendrá efecto, y el registro del permiso permanece en Configuración del Sistema después de expulsar la imagen de disco. Arrastra ProperWM a la carpeta Aplicaciones y ábrelo desde ahí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS associa a permissão de Acessibilidade a uma cópia específica de um app. Esta cópia está em execução a partir de um local temporário ou somente leitura, portanto ativar o interruptor não terá efeito — e o registro da permissão continua nos Ajustes do Sistema depois que a imagem de disco é ejetada. Arraste o ProperWM para a pasta Aplicativos e abra-o de lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS associa a permissão de Acessibilidade a uma cópia específica de uma aplicação. Esta cópia está a ser executada a partir de uma localização temporária ou só de leitura, pelo que ativar o interruptor não terá efeito – e o registo da permissão permanece nas Definições do Sistema depois de a imagem de disco ser ejetada. Arraste o ProperWM para a pasta Aplicações e abra-o a partir daí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS associa l’autorizzazione di accessibilità a una copia specifica di un’app. Questa copia viene eseguita da una posizione temporanea o di sola lettura, quindi attivare l’interruttore non avrà effetto; inoltre l’autorizzazione resta registrata in Impostazioni di Sistema anche dopo l’espulsione dell’immagine disco. Trascina ProperWM nella cartella Applicazioni e aprilo da lì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 손쉬운 사용 권한을 앱의 특정 사본 하나에 연결합니다. 이 사본은 임시 위치 또는 읽기 전용 위치에서 실행 중이므로 스위치를 켜도 적용되지 않으며, 디스크 이미지를 추출한 뒤에도 권한 기록이 시스템 설정에 남게 됩니다. ProperWM를 응용 프로그램 폴더로 드래그한 다음 그곳에서 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS привязывает разрешение универсального доступа к конкретной копии приложения. Эта копия запущена из временной папки или с носителя только для чтения, поэтому включение переключателя не подействует, а запись о разрешении останется в Системных настройках после извлечения образа диска. Перетащите ProperWM в папку «Приложения» и откройте приложение оттуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Erişilebilirlik iznini bir uygulamanın belirli bir kopyasına bağlar. Bu kopya geçici veya salt okunur bir konumdan çalıştığı için anahtarı açmak etki etmez — ayrıca disk görüntüsü çıkarıldıktan sonra izin kaydı Sistem Ayarları’nda kalır. ProperWM’i Uygulamalar klasörünüze sürükleyin ve oradan açın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ऐक्सेसिबिलिटी अनुमति को ऐप की किसी एक ख़ास कॉपी से जोड़ता है। यह कॉपी किसी अस्थायी या रीड-ओनली जगह से चल रही है, इसलिए स्विच चालू करने का कोई असर नहीं होगा — और डिस्क इमेज बाहर निकालने के बाद भी अनुमति का रिकॉर्ड सिस्टम सेटिंग में बचा रहता है। ProperWM को ऐप्लिकेशन फ़ोल्डर में ड्रैग करें और वहीं से खोलें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gắn quyền Trợ năng với một bản sao cụ thể của ứng dụng. Bản sao này đang chạy từ vị trí tạm thời hoặc chỉ đọc, vì vậy việc bật công tắc sẽ không có hiệu lực — và bản ghi quyền vẫn còn lại trong Cài đặt hệ thống sau khi ảnh đĩa được tháo. Hãy kéo ProperWM vào thư mục Ứng dụng rồi mở từ đó."
          }
        }
      }
    }
  },
  "version": "1.0"
}
