    "This copy is running from a temporary or read-only location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前副本位于临时或只读位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is running from a temporary or read-only location."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前這份副本執行於暫時或唯讀的位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーは一時的な場所または読み出し専用の場所で実行されています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie läuft von einem temporären oder schreibgeschützten Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie s’exécute depuis un emplacement temporaire ou en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia se está ejecutando desde una ubicación temporal o de solo lectura."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia se está ejecutando desde una ubicación temporal o de sólo lectura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia está sendo executada a partir de um local temporário ou somente leitura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia está a ser executada a partir de uma localização temporária ou só de leitura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia viene eseguita da una posizione temporanea o di sola lettura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사본은 임시 위치 또는 읽기 전용 위치에서 실행 중입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия запущена из временной папки или с носителя только для чтения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya geçici veya salt okunur bir konumdan çalışıyor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कॉपी किसी अस्थायी या रीड-ओनली जगह से चल रही है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao này đang chạy từ vị trí tạm thời hoặc chỉ đọc."
          }
        }
      }
    },
    "This will only take a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马上就好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will only take a moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很快就好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに終わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert nur einen Moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne prendra qu’un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tardará un momento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo tardará un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso levará apenas um instante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto demora apenas um instante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci vorrà solo un attimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시면 끝납니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это займет всего минуту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
