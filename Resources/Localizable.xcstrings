    "Switch already on but nothing happens?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经打开开关，却还是没反应？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch already on but nothing happens?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關已經打開，卻還是沒有反應？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチはオンなのに何も起きませんか?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalter ist an, aber nichts passiert?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interrupteur est déjà activé, mais rien ne se passe ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El interruptor ya está activado pero no pasa nada?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El interruptor ya está activado pero no pasa nada?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O interruptor já está ativado, mas nada acontece?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O interruptor já está ativado, mas nada acontece?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interruttore è già attivo ma non succede nulla?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치를 이미 켰는데 반응이 없습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
