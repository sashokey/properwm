    "Nothing to do here — just a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候，不用操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do here — just a moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用操作，請稍候。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は不要です。少しお待ちください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst nichts tun. Bitte warte einen Moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action nécessaire — patientez un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta que hagas nada: espera un momento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas hacer nada: espera un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada a fazer aqui — só um instante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa de fazer nada – só um instante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi fare nulla: ci vorrà solo un attimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 할 일은 없습니다. 잠시만 기다리십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего делать не нужно — подождите немного."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yapılacak bir şey yok — bir saniye."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कुछ करने की ज़रूरत नहीं — बस एक क्षण।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không cần làm gì ở đây — chỉ một lát thôi."
          }
        }
      }
    },
